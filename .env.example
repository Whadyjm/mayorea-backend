ADDR=:8080
# postgres | memory (memory loses data on restart; handy for frontend work)
STORAGE=postgres
DATABASE_URL=postgres://mayorea:mayorea@localhost:5432/mayorea?sslmode=disable
CORS_ORIGINS=http://localhost:5173
TIMEZONE=America/Caracas

# Sessions last this long; drivers work offline all day, so don't make it too short.
SESSION_TTL=24h

# Only these emails may be owners (the role that manages users); other roles are created by owners (comma separated).
# Leave empty to lift the restriction.
ACCESS_ALLOWLIST=
# Owners created at startup if missing; existing accounts are never touched.
# Format: Name|email|password;Name|email|password   (change the passwords after first login)
BOOTSTRAP_OWNERS=

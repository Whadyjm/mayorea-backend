ADDR=:8080
# postgres | memory (memory loses data on restart; handy for frontend work)
STORAGE=postgres
DATABASE_URL=postgres://mayorea:mayorea@localhost:5432/mayorea?sslmode=disable
CORS_ORIGINS=http://localhost:5173
TIMEZONE=America/Caracas

# Sessions last this long; drivers work offline all day, so don't make it too short.
SESSION_TTL=24h
# The first owner is created from these only while the system has no users.
# Change the password right after the first login (POST /api/v1/auth/password).
BOOTSTRAP_OWNER_NAME=Dueño
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
